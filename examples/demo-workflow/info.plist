<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>bundleid</key>
	<string>com.clone.demo</string>
	<key>connections</key>
	<dict>
		<key>A1</key>
		<array>
			<dict>
				<key>destination</key>
				<string>B1</string>
				<key>destinationuid</key>
				<string>B1</string>
			</dict>
		</array>
	</dict>
