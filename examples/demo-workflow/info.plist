			<key>type</key>
			<string>alfred.workflow.trigger.keyword</string>
			<key>uid</key>
			<string>A1</string>
		</dict>
		<dict>
			<key>type</key>
			<string>alfred.workflow.action.openurl</string>
			<key>uid</key>
			<string>B1</string>
			<key>url</key>
			<string>https://duckduckgo.com/?q={query}</string>
		</dict>
	</array>
